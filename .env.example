# Copy to .env and fill in. Never commit .env.

# ── Required ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=            # long random string; signs sign-in tokens (all services share it)
AI_KEYS_SECRET=            # long random string; encrypts the Gemini keys stored by admins
GEMINI_API_KEY=            # fallback key; admins normally add keys on the AI API Keys page
DEEPSEEK_API_KEY=          # optional: DeepSeek for written answers (choose the engine on the AI API Keys page)

# ── Optional ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=        # from @BotFather; the bot starts only when this is set
ADVISORY_EMERGENCY_CONTACT=  # verified poisoning/emergency number (PLACEHOLDER until confirmed)
ADVISORY_OFFLINE=0         # 1 = replay recorded answers, no internet calls (demo kit)
APP_PUBLIC_URL=            # e.g. https://agristack.example; used in QR codes and links

# AI models and providers (defaults are fine)
ADVISORY_LLM_PROVIDER=gemini
ADVISORY_LLM_MODEL=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
ADVISORY_EMBED_PROVIDER=gemini
ADVISORY_EMBED_MODEL=
ADVISORY_STT_MODEL=
ADVISORY_TTS_MODEL=
ADVISORY_WEATHER_PROVIDER=
ADVISORY_WEATHER_FIXTURE=

# Local services
ADVISORY_DISEASE_URL=http://127.0.0.1:8003
ADVISORY_FORECAST_URL=http://127.0.0.1:8001
TTS_SERVICE_URL=http://127.0.0.1:8004
TTS_PRELOAD=
TTS_ASR_IDLE=

# Data locations (defaults: project root)
NMIS_PLATFORM_DB=
NMIS_PRICES_DB=
NMIS_CSV_EXPORT=
NMIS_MODEL_DIR=
NMIS_MODEL_REGISTRY=
NMIS_SYNC_LOG_DIR=

# ATI Farmer Profile System (off unless ADVISORY_PROFILE_PROVIDER=ati) — see docs/integrations.md
ADVISORY_PROFILE_PROVIDER=local
ATI_FARMER_PROFILE_URL=
ATI_FARMER_PROFILE_KEY=
ATI_FARMER_PROFILE_MAPPING=
ATI_FARMER_PROFILE_STRICT=0

# OpenAgriNet / Beckn provider (off unless BECKN_ENABLED=1) — see docs/integrations.md
BECKN_ENABLED=0
BECKN_SUBSCRIBER_ID=
BECKN_SUBSCRIBER_URL=
BECKN_UNIQUE_KEY_ID=
BECKN_SIGNING_PRIVATE_KEY=   # from scripts/beckn_keygen.py
BECKN_TRUSTED_KEYS=
BECKN_DOMAIN=
BECKN_CORE_VERSION=1.1.0

# Frontend (frontend/.env.local)
# VITE_API_URL=  VITE_FORECAST_URL=  VITE_SYNC_URL=  VITE_OFFLINE=0  VITE_DEMO_LOGINS=0
